{
  "name": "Nbed",
  "version": "0.2.1",
  "description": "Nbedは、長岡高専ロボティクス部が2026年に開発したSTM32シリーズ向けのマイコン制御ライブラリです。STM32 HALをより簡単かつ扱いやすく利用できるようにすることを目的として開発されています。",
  "keywords": [
    "stm32",
    "stm32f4",
    "nucleo-f446re",
    "hal"
  ],
  "frameworks": [
    "stm32cube"
  ],
  "platforms": [
    "ststm32"
  ],
  "dependencies": {
    "logger": "https://github.com/nnctroboticsclub/logger/archive/refs/tags/v0.3.0.zip"
  },
  "build": {
    "extraScript": "extra_script.py"
  }
}
