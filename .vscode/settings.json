{
  // 共有するコード規約とツール設定。表示・自動保存・ターミナルは個人設定。
  "files.encoding": "utf8",
  "files.eol": "\n",
  "[c]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  },
  "[cpp]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  },
  "files.associations": {
    "*.h": "cpp",
    ".clangd": "yaml",
    ".clang-format": "yaml",
    "LICENSE": "plaintext",
  },
  "C_Cpp.intelliSenseEngine": "disabled",

  // vscode-clangd が userHome を解決するためWindows・macOS・Linuxで共通。
  // PlatformIO Coreの保存先を変更したPCは、個人設定側でこの配列を上書きする。
  "clangd.arguments": [
    "--query-driver=${userHome}/.platformio/packages/toolchain-gccarmnoneeabi/bin/arm-none-eabi-*",
    "--compile-commands-dir=${workspaceFolder}"
  ],
  // 監視対象のルートDBが変わった場合にだけ再起動する。
  // clangd自身の遅延再読込に加え、開いているファイルの診断も更新する。
  "clangd.onConfigChanged": "restart",
  "clangd.onConfigChangedForceEnable": true,
  "files.exclude": { "**/.git": true },
  "files.watcherExclude": {
    "**/.cache/**": true,
    "**/.pio/**": true,
    "**/build/**": true
  },
  "search.exclude": {
    "**/.cache/**": true,
    "**/.pio/**": true,
    "**/build/**": true,
    "**/compile_commands.json": true
  }
}
