{
  // 共有するコード規約・ツール・ファイルの扱い。
  "files.encoding": "utf8",
  "files.eol": "\n",
  "[c]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  },
  "[cpp]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  },
  "C_Cpp.intelliSenseEngine": "disabled",

  // 標準のPlatformIO保存先。保存先を変更したプロジェクトでは配列を調整する。
  "clangd.arguments": [
    "--query-driver=${userHome}/.platformio/packages/toolchain-gccarmnoneeabi/bin/arm-none-eabi-*",
    "--compile-commands-dir=${workspaceFolder}"
  ],
  // コンパイルDB・compile_flags.txt の変更時は、自動再読込対応版でも再起動する。
  "clangd.onConfigChanged": "restart",
  "clangd.onConfigChangedForceEnable": true,

  // ヘッダーはC++として扱う。C主体のプロジェクトでは *.h の関連付けを変更する。
  "files.associations": {
    "*.h": "cpp",
    ".clangd": "yaml",
    ".clang-format": "yaml",
    "LICENSE": "plaintext"
  },
  // 一覧ではgit・生成DBを隠す。設定・ログは表示する。
  "files.exclude": {
    "**/.git": true,
    "compile_commands.json": true
  },
  // 監視除外はルート直下の成果物だけ。コンパイルDBは更新を検知する。
  "files.watcherExclude": {
    ".cache/**": true,
    ".pio/**": true,
    "build/**": true
  },
  // 通常検索から設定と成果物を除外。src/build/ などの同名フォルダは対象に含める。
  "search.exclude": {
    ".vscode/**": true,
    "*.code-workspace": true,
    ".editorconfig": true,
    ".gitignore": true,
    ".gitattributes": true,
    ".clangd": true,
    ".clang-format": true,
    ".clang-tidy": true,
    "platformio.ini": true,
    ".cache/**": true,
    ".pio/**": true,
    "build/**": true,
    "compile_commands.json": true
  }
}
